# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=admin
DATABASE_NAME=suenos-dev

# Redis (cache + colas Bull)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (almacenamiento S3-compatible; hoy usado para imágenes de portada de
# cursos bajo el prefijo covers/, ver MinioImageStorageAdapter)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=suenos-dev
# Host desde el que el NAVEGADOR debe poder llegar a MinIO — distinto de
# MINIO_ENDPOINT cuando la API corre dentro de Docker (ahí MINIO_ENDPOINT es
# el nombre del servicio, ej. "minio", inalcanzable desde el navegador).
MINIO_PUBLIC_URL=http://localhost:9000

# JWT (autenticacion)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Stripe (usar claves de modo test de tu propia cuenta: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Email (prioridad de fallback: Resend > SendGrid > Nodemailer/SMTP)
EMAIL_FROM=noreply@suenos-dev.dev
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# OAuth - Google (dejar vacío para deshabilitar; la estrategia no falla si faltan)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth - GitHub (dejar vacío para deshabilitar; la estrategia no falla si faltan)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Sentry (opcional — dejar vacío para deshabilitar)
SENTRY_DSN=

# Node / puerto de la API
NODE_ENV=development
PORT=3001

# URLs de la app
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
