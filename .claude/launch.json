{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=apps/web"],
      "port": 3000
    },
    {
      "name": "api-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--workspace=apps/api"],
      "port": 3001
    }
  ]
}
