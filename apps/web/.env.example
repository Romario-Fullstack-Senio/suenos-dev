NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Origen público del sitio (sin barra final) — usado para metadata/OG/sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Debe coincidir con JWT_SECRET en apps/api/.env — usado por middleware.ts
# para verificar la sesión server-side. Sin NEXT_PUBLIC_: no llega al bundle.
JWT_SECRET=dev-secret
