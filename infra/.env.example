# ============================================================
# .env.example — Variables de producción para suenos-dev
# Copiar a .env y reemplazar todos los placeholders
# ============================================================

# ──────────────────────────────────────────────
# Imágenes Docker (tags del SHA de commit)
# ──────────────────────────────────────────────
API_TAG=latest
WEB_TAG=latest

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_DB=suenos_prod
POSTGRES_USER=suenos_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ──────────────────────────────────────────────
# MinIO (Object Storage)
# ──────────────────────────────────────────────
MINIO_ROOT_USER=suenos_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_HERE
MINIO_BUCKET=suenos-dev

# ──────────────────────────────────────────────
# JWT (generar con: openssl rand -hex 32)
# ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_HEX_32
JWT_EXPIRATION=7d

# ──────────────────────────────────────────────
# Stripe (Producción)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ──────────────────────────────────────────────
# Email (Resend — preferido para producción)
# ──────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@suenos-dev.dev

# ──────────────────────────────────────────────
# Email (SMTP — fallback / desarrollo local)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@suenos-dev.dev

# ──────────────────────────────────────────────
# Sentry (Opcional — dejar vacío para deshabilitar)
# ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DSN_WEB=

# ──────────────────────────────────────────────
# SendGrid (Opcional — fallback si Resend no está configurado)
# ──────────────────────────────────────────────
SENDGRID_API_KEY=

# ──────────────────────────────────────────────
# Redis (Bull queue para procesamiento async de emails)
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────
# OAuth - Google
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=https://api.suenos-dev.dev/api/auth/google/callback

# ──────────────────────────────────────────────
# OAuth - GitHub
# ──────────────────────────────────────────────
GITHUB_CLIENT_ID=tu-github-client-id
GITHUB_CLIENT_SECRET=tu-github-client-secret
GITHUB_CALLBACK_URL=https://api.suenos-dev.dev/api/auth/github/callback

# ──────────────────────────────────────────────
# URLs de la aplicación
# ──────────────────────────────────────────────
APP_URL=https://suenos-dev.dev
API_URL=https://api.suenos-dev.dev

# ──────────────────────────────────────────────
# Caddy (Certificados SSL)
# ──────────────────────────────────────────────
CADDY_EMAIL=admin@suenos-dev.dev
