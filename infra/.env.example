# ============================================================
# .env.example — Variables de producción para suenos-dev
# Copiar a .env (producción) o a .env.preprod (preproducción, junto con
# infra/.env.preprod.example que ya trae los overrides típicos) y
# reemplazar todos los placeholders.
#
# Los nombres de acá tienen que coincidir EXACTO con lo que lee el código
# (apps/api/src/app.module.ts, identity.module.ts, main.ts) — antes este
# archivo usaba POSTGRES_DB/POSTGRES_USER/DB_HOST/JWT_EXPIRATION, que la
# API nunca leía, y el deploy real se hubiera roto en el primer arranque.
# ============================================================

# ──────────────────────────────────────────────
# Imágenes Docker (tags del SHA de commit — el pipeline de deploy los pisa)
# ──────────────────────────────────────────────
API_TAG=latest
WEB_TAG=latest

# ──────────────────────────────────────────────
# Puertos publicados en el host (127.0.0.1) — cambiar SOLO si corrés más
# de un stack (prod + preprod) en el mismo servidor; ver
# infra/.env.preprod.example para los valores que no chocan con estos.
# ──────────────────────────────────────────────
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=3001
WEB_HOST_PORT=3000

# ──────────────────────────────────────────────
# PostgreSQL — mismos nombres que lee la API (config.get('DATABASE_*'))
# ──────────────────────────────────────────────
DATABASE_NAME=suenos_prod
DATABASE_USER=suenos_admin
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ──────────────────────────────────────────────
# Redis — usado por BullModule (cola de emails, ver app.module.ts)
# ──────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ──────────────────────────────────────────────
# MinIO (Object Storage) — mismos nombres que usa el resto del proyecto
# (MINIO_ACCESS_KEY/MINIO_SECRET_KEY), no MINIO_ROOT_USER/PASSWORD.
# MINIO_PUBLIC_URL es el host que debe poder alcanzar el NAVEGADOR — con
# Caddy fronteando, normalmente https://minio.tu-dominio, o dejalo apuntando
# al puerto publicado si servís los archivos directo (127.0.0.1 nunca
# funciona acá, tiene que ser una URL alcanzable desde afuera).
# ──────────────────────────────────────────────
MINIO_ACCESS_KEY=suenos_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD_HERE
MINIO_BUCKET=suenos-dev
MINIO_PUBLIC_URL=https://minio.suenos-dev.dev

# ──────────────────────────────────────────────
# JWT (generar con: openssl rand -hex 32)
# JWT_EXPIRES_IN (no JWT_EXPIRATION) — así lo lee identity.module.ts.
# Este mismo valor va TAMBIÉN al contenedor `web` (middleware.ts lo
# necesita para verificar el sessionToken) — el compose ya lo referencia
# dos veces desde esta única variable, no hace falta duplicarla acá.
# ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_HEX_32
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Stripe (Producción: sk_live_/pk_live_ — en preprod usar sk_test_/pk_test_)
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ──────────────────────────────────────────────
# Email (Resend — preferido; fallback SendGrid, luego SMTP/Nodemailer)
# ──────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
SENDGRID_API_KEY=
EMAIL_FROM=noreply@suenos-dev.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@suenos-dev.dev

# ──────────────────────────────────────────────
# Sentry (Opcional — dejar vacío para deshabilitar)
# ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_DSN_WEB=

# ──────────────────────────────────────────────
# OAuth - Google (dejar vacío para deshabilitar)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.suenos-dev.dev/api/auth/google/callback

# ──────────────────────────────────────────────
# OAuth - GitHub (dejar vacío para deshabilitar)
# ──────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.suenos-dev.dev/api/auth/github/callback

# ──────────────────────────────────────────────
# URLs de la aplicación — WEB_URL para CORS en la API sale de APP_URL
# directamente en el compose (no hace falta repetirlo acá).
# ──────────────────────────────────────────────
APP_URL=https://suenos-dev.dev
API_URL=https://api.suenos-dev.dev

# ──────────────────────────────────────────────
# Swagger — en producción real, dejar en false (ver main.ts). Habilitarlo
# solo en preprod si hace falta explorar la API ahí.
# ──────────────────────────────────────────────
ENABLE_SWAGGER=false

# ──────────────────────────────────────────────
# Caddy (Certificados SSL)
# ──────────────────────────────────────────────
CADDY_EMAIL=admin@suenos-dev.dev
