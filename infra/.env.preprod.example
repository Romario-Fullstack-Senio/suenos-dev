# ============================================================
# .env.preprod.example — Overrides para el stack de PREPRODUCCIÓN
#
# Preprod usa el MISMO docker-compose.prod.yml que producción — la única
# diferencia real es este archivo de variables. Copiar a .env.preprod en
# ~/deploy/suenos-dev-preprod/ junto con el resto de las variables de
# infra/.env.example (Stripe en modo TEST, credenciales propias de DB/Redis/
# MinIO — nunca reutilizar las de producción).
#
# Se levanta con:
#   docker compose -p suenos-preprod --env-file .env.preprod \
#     -f docker-compose.prod.yml up -d
# (el flag -p separa el proyecto de Compose — contenedores, red y volúmenes
# quedan namespaceados aparte de los de "suenos-dev" sin tocar nombres a mano)
# ============================================================

# Puertos distintos a los de prod para poder correr ambos stacks en el
# mismo servidor sin choque de puertos en 127.0.0.1.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
API_HOST_PORT=3101
WEB_HOST_PORT=3100

# Subdominio de preprod (agregar el bloque correspondiente al Caddyfile —
# ver infra/Caddyfile, sección "PREPRODUCCIÓN").
APP_URL=https://preprod.suenos-dev.dev
API_URL=https://api-preprod.suenos-dev.dev

# Stripe: SIEMPRE claves de modo test acá, nunca las de producción.
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# Útil para poder inspeccionar la API en preprod sin exponerlo en prod.
ENABLE_SWAGGER=true

# JWT_SECRET propio de preprod — NO el mismo que producción (si se
# comparte, una sesión firmada en preprod sería válida en prod y viceversa).
JWT_SECRET=CHANGE_ME_GENERATE_OTRO_HEX_32_DISTINTO_AL_DE_PROD

# Credenciales de infra propias de preprod (DB/Redis/MinIO) — no
# reutilizar las de producción, para que un bug en preprod no pueda tocar
# datos reales.
DATABASE_NAME=suenos_preprod
DATABASE_USER=suenos_preprod_admin
DATABASE_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=suenos_preprod_minio
MINIO_SECRET_KEY=CHANGE_ME
MINIO_PUBLIC_URL=https://minio-preprod.suenos-dev.dev

CADDY_EMAIL=admin@suenos-dev.dev
